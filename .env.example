# Django
DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Base de datos: sqlite (por defecto) o postgres
DB_ENGINE=sqlite
POSTGRES_DB=guiospro
POSTGRES_USER=guiospro
POSTGRES_PASSWORD=guiospro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS (frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Literatura con IA
# openai | gemini | mock (heurístico, sin clave)
LITERATURE_PROVIDER=mock
LITERATURE_PROMPT_VERSION=1
LITERATURE_YEAR_FROM=2020
LITERATURE_YEAR_TO=2026
LITERATURE_MAX_CANDIDATES=25
LITERATURE_TIMEOUT=90
LITERATURE_CONTACT_EMAIL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MIN_INTERVAL=4.5

SEMANTIC_SCHOLAR_API_KEY=
